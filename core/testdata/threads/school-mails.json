{
  "id": "school-mails",
  "what": "Les mails de l'école, d'une boîte qui n'est pas de confiance : un thread léger qui porte la liste en source vivante (chaque mail une ligne), une note sur chacun, l'action recommandée offerte sur sa ligne (un clic fait une carte), et une partie qui compose ces lignes et leurs groupes avec leurs offres (Offers) ; écrite après un contenu extérieur, « extérieur » à côté.",
  "lang": "fr",
  "seed": 50,
  "servers": [
    {"name": "postbox", "use": "les mails de Sam", "trusted": false, "tools": [
      {"name": "list_messages", "description": "List the messages received from a sender, the newest first: id, from, subject, date, snippet.",
        "input_schema": {"type": "object", "properties": {"from": {"type": "string"}}, "required": ["from"]},
        "result": {"messages": [
          {"id": "m-301", "from": "École des Tilleuls <contact@ecole.example.org>", "subject": "Sortie au musée jeudi : autorisation à rendre", "date": "2026-11-12T16:20:00+01:00", "snippet": "Merci de rendre l'autorisation signée avant mercredi."},
          {"id": "m-298", "from": "École des Tilleuls <contact@ecole.example.org>", "subject": "Menus de la cantine, semaine 47", "date": "2026-11-10T09:05:00+01:00", "snippet": "Vous trouverez ci-joint les menus."},
          {"id": "m-297", "from": "Association des parents <parents@ecole.example.org>", "subject": "Vente de gâteaux vendredi", "date": "2026-11-09T19:40:00+01:00", "snippet": "Les parents qui le souhaitent peuvent apporter un gâteau."}]}},
      {"name": "archive", "description": "Archive a message.", "changes": true,
        "input_schema": {"type": "object", "properties": {"id": {"type": "string"}}, "required": ["id"]},
        "result": {"archived": true}}
    ]}
  ],
  "request": "Montre-moi les mails de l'école de cette semaine.",
  "expect": {"about": ["ecole"]},
  "answer": {
    "calls": [
      {"tool": "open_thread", "args": {"title": "Les mails de l'école", "goal": "Sam a traité les mails de l'école de la semaine.", "alias": "topic:mails-ecole"}},
      {"tool": "link_thread", "args": {"thread_id": 51, "source": {"name": "ecole", "tool": "postbox/list_messages", "args": {"from": "ecole.example.org"},
        "items": {"path": "messages", "id": "id", "title": "subject", "detail": "from"}}}},
      {"tool": "note_item", "args": {"source": "ecole", "item": "m-301", "note": "Une autorisation de sortie à signer et rendre avant mercredi.", "state": "act", "due": "2026-11-18"}},
      {"tool": "note_item", "args": {"source": "ecole", "item": "m-298", "note": "Les menus de la semaine, rien à faire.", "state": "none",
        "actions": [{"label": "Archiver", "tool": "postbox/archive", "args": {"id": "$item"}}]}},
      {"tool": "note_item", "args": {"source": "ecole", "item": "m-297", "note": "Une vente de gâteaux vendredi, si tu veux en apporter un.", "state": "info",
        "actions": [{"label": "Archiver", "tool": "postbox/archive", "args": {"id": "$item"}}]}},
      {"tool": "surface_write", "args": {"id": "thread-51", "block": "mails",
        "components": [
          {"id": "root", "component": "List", "children": {"path": "/thread/items/ecole/groups", "componentId": "groupe"}, "emptyText": "Rien de l'école cette semaine"},
          {"id": "groupe", "component": "Column", "children": ["groupe_tete", "groupe_lignes"]},
          {"id": "groupe_tete", "component": "Row", "align": "center", "justify": "spaceBetween", "children": ["groupe_titre", "groupe_offres"]},
          {"id": "groupe_titre", "component": "Text", "variant": "subtitle", "text": {"@path": "label"}},
          {"id": "groupe_offres", "component": "Offers", "offers": {"@path": "offers"}},
          {"id": "groupe_lignes", "component": "List", "children": {"path": "items", "componentId": "ligne"}},
          {"id": "ligne", "component": "Column", "children": ["ligne_item", "ligne_offres"]},
          {"id": "ligne_item", "component": "Item", "title": {"@path": "title"}, "detail": {"@path": "detail"}, "note": {"@path": "note"}, "due": {"@path": "due"}, "mark": {"@path": "mark"}, "level": {"@path": "level"}},
          {"id": "ligne_offres", "component": "Offers", "offers": {"@path": "offers"}}
        ]}},
      {"tool": "workspace_focus", "args": {"id": "thread-51"}}
    ],
    "reply": "Trois mails de l'école cette semaine, au centre : une autorisation à rendre avant mercredi."
  }
}
