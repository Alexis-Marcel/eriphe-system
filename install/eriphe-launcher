#!/bin/sh
# eriphe-launcher: Eriphe on a NAS or any Linux with Docker, from one
# container (ghcr.io/alexis-marcel/eriphe, install/README.md, One container):
#
#   docker run -d --name eriphe --restart unless-stopped \
#     --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER \
#     --read-only --tmpfs /tmp --security-opt no-new-privileges \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -v /mnt/user/appdata/eriphe:/data \
#     ghcr.io/alexis-marcel/eriphe
#
# It creates and keeps running the containers install.sh makes on a Linux
# host, with install.sh's own functions (sourced): eriphe-core in core mode,
# with no Docker access; eriphe-node, which reaches Docker only through the
# socket proxy; the proxy; the task network. Their data is under /data, given
# to them at its path on the host, which it reads from its own container.
# It listens on no port and runs nothing else; it is their updater: it
# applies eriphe-core's and the node's update requests as install.sh's
# updater does, then updates itself. It keeps the list of the folders of
# this machine shared with Eriphe (eriphe share): the socket proxy lets the
# node's tasks have those folders only, nothing else of the host.
#
#   eriphe-launcher run                 the container's command
#   eriphe-launcher update              update now, as the workspace's Update
#   eriphe-launcher rollback            back to the version before the last update
#   eriphe-launcher uninstall [--data]  remove the containers it made (and the data)
#   eriphe-launcher share ...           the folders shared (eriphe share --help), also
#                                       as: docker exec eriphe eriphe share add FOLDER
#   eriphe-launcher swap ID             (its own) replace container ID by one of this image
set -eu

ERIPHE_INSTALL_LIB=1
# shellcheck source=install/install.sh
. "${ERIPHE_LAUNCHER_LIB:-/usr/local/lib/eriphe/install.sh}"

# What eriphe-launcher sees: /data, its compose project in /data/launcher.
DATA=${ERIPHE_LAUNCHER_DATA:-/data}
CONF=$DATA/launcher
SOCK=/var/run/docker.sock
LAUNCHER_REPO=${ERIPHE_LAUNCHER_REPO:-$REGISTRY/eriphe} # another for a test registry
SWAP=eriphe-launcher-swap
OS=Linux NATIVE='' INSTALL=docker
MOUNTINFO=${ERIPHE_MOUNTINFO:-/proc/self/mountinfo}
# The folders shared, one host path a line (:ro: a read-only one, kept from
# a place of an earlier install); the proxy's copy of it, in a folder of the
# data the node never sees; the folders Syncthing has now (it may copy them).
FOLDERS=$CONF/folders
BINDS=$DATA/proxy/binds
COPIED_NOW=$CONF/copied
NL='
'

log() { printf '%s eriphe-launcher: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2; }
dc() { docker compose -p eriphe --project-directory "$CONF" -f "$CONF/compose.yaml" --env-file "$CONF/.env" "$@"; }

# default_name: the Docker host's name (the container's is its id).
default_name() {
	docker info -f '{{.Name}}' 2>/dev/null | cut -d . -f 1 | tr 'A-Z_' 'a-z-' | tr -cd 'a-z0-9-' | sed 's/^-*//; s/-*$//'
}

mount_source() {
	docker inspect -f '{{range .Mounts}}{{if eq .Destination "'"$2"'"}}{{.Source}}{{end}}{{end}}' "$1"
}

# discover: this container (SELF, its image SELF_IMAGE under SELF_REF) and
# the host paths of /data (HOST_DATA) and of the socket (HOST_SOCK).
discover() {
	id=$(sed -n 's|.*/containers/\([0-9a-f]\{64\}\)/.*|\1|p' "$MOUNTINFO" 2>/dev/null | head -n 1)
	[ -n "$id" ] || id=$(hostname)
	SELF=$(docker inspect -f '{{.Id}}' "$id" 2>/dev/null) ||
		die "cannot see this container through Docker: give it the socket, -v $SOCK:$SOCK"
	SELF_NAME=$(docker inspect -f '{{.Name}}' "$SELF" | sed 's|^/||')
	SELF_IMAGE=$(docker inspect -f '{{.Image}}' "$SELF")
	SELF_REF=$(docker inspect -f '{{.Config.Image}}' "$SELF")
	HOST_SOCK=$(mount_source "$SELF" "$SOCK")
	[ -n "$HOST_SOCK" ] || die "mount the Docker socket: -v $SOCK:$SOCK"
	HOST_DATA=$(mount_source "$SELF" "$DATA")
	[ -n "$HOST_DATA" ] || die "mount a folder of the host at $DATA, for Eriphe's data: -v /srv/eriphe:$DATA (on Unraid /mnt/user/appdata/eriphe)"
	case $HOST_DATA in
	/ | *[!A-Za-z0-9/._-]*) die "$HOST_DATA: Eriphe's data folder is not / and has only letters, digits, /, ., _ or -" ;;
	/*) ;;
	*) die "$HOST_DATA is not an absolute path" ;;
	esac
}

# ref_repo REF: REF without its tag or digest.
ref_repo() {
	r=${1%@*}
	case ${r##*/} in
	*:*) r=${r%:*} ;;
	esac
	printf '%s' "$r"
}

# ref_tag REF: its tag, latest when it has none.
ref_tag() {
	r=${1%@*}
	case ${r##*/} in
	*:*) printf '%s' "${r##*:}" ;;
	*) printf latest ;;
	esac
}

# version_tag VERSION: the images' tag of a build, as install.sh's updater:
# X.Y.Z, sha-<commit> for a build of main; nothing for a local one.
version_tag() {
	case $1 in
	*-dev+*) t=sha-${1##*+} ;;
	*+*) t= ;;
	*) t=$1 ;;
	esac
	printf '%s' "$t" | grep -Eq '^(sha-[0-9a-f]{7,40}|[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?)$' && printf '%s' "$t"
}

# settings: install.sh's options, from the environment. They are the
# container's settings: what is not given is not kept from a run before.
settings() {
	mode=${ERIPHE_MODE:-core}
	saved=$(sed -n 's/^mode=//p' "$CONF/install.conf" 2>/dev/null || true)
	if [ -n "$saved" ] && [ "$saved" != "$mode" ]; then
		die "$HOST_DATA holds a $saved-mode install: ERIPHE_MODE=$mode needs another data folder (or eriphe-launcher uninstall --data first)"
	fi
	set --
	case $mode in
	core)
		[ -z "${ERIPHE_CORE:-}" ] || die "ERIPHE_CORE is for ERIPHE_MODE=node: in core mode eriphe-core runs here"
		set -- --core-mode
		;;
	node)
		[ -n "${ERIPHE_CORE:-}" ] || die "ERIPHE_MODE=node joins an eriphe-core: give its address in ERIPHE_CORE (https://192.0.2.10:8800)"
		[ -f "$DATA/node/node.json" ] || [ -n "${ERIPHE_JOIN_TOKEN:-}" ] ||
			die "a new node needs ERIPHE_JOIN_TOKEN: the workspace's Connect a device gives it"
		;;
	*) die "ERIPHE_MODE is core or node, not $mode" ;;
	esac
	# The version: ERIPHE_VERSION, or this image's tag (eriphe:edge follows main).
	pin=${ERIPHE_VERSION:-}
	if [ -z "$pin" ]; then
		pin=$(ref_tag "$SELF_REF")
		printf '%s' "$pin" | grep -Eq '^(latest|edge|sha-[0-9a-f]{7,40}|[0-9]+\.[0-9]+(\.[0-9]+(-[0-9A-Za-z.-]+)?)?)$' || pin=latest
	fi
	# No place: the folders shared are the launcher's list (eriphe share).
	set -- "$@" --version "$pin" --labels "${ERIPHE_NODE_LABELS:-}" --model-server "${ERIPHE_MODEL_SERVER:-}" --no-share
	parse_args "$@" # ERIPHE_BIND too
	BIND_SET=1      # not kept from a run before either
	FOLDER_HELPER=1 # install.sh's compose: the node mounts no folder, the proxy reads $BINDS
	COPIED=$(copied) || COPIED=$(cat "$COPIED_NOW" 2>/dev/null || true)
	SHARE_COMMAND="docker exec ${SELF_NAME:-eriphe} eriphe share"
	[ -z "${ERIPHE_SHARES:-}" ] ||
		log "ERIPHE_SHARES is no longer used: remove it from this container's settings. Share a folder with: $SHARE_COMMAND add <folder>"
	WEB_PORT=${ERIPHE_WEB_PORT:-8443} API_PORT=${ERIPHE_API_PORT:-8800}
	for p in "$WEB_PORT" "$API_PORT"; do
		if ! printf '%s' "$p" | grep -Eq '^[1-9][0-9]{0,4}$' || [ "$p" -gt 65535 ]; then
			die "a port is 1 to 65535, not $p"
		fi
	done
	[ "$WEB_PORT" != "$API_PORT" ] || die "ERIPHE_WEB_PORT and ERIPHE_API_PORT are the same port"
}

# ---- The folders shared (eriphe share)
#
# eriphe-node mounts no shared folder: a task gets its folders from the
# Docker daemon when its container is made, through the socket proxy, which
# allows bind mounts from the folders of the launcher's list only ($BINDS,
# read again at each request). What the node does in a folder (its checks,
# a snapshot, a restore, a results subfolder) runs in a short-lived
# container of its image given that folder only (node/helper.go). Sharing a
# folder, or stopping, so restarts nothing: the next task has it, or no
# longer has it; a task at work keeps what it was given until it ends (the
# node lends a folder no longer shared to no new task). Syncthing alone sees
# the folders it may copy, each mounted at its path: it is made again (its
# copies pause a few seconds) when they change. The node keeps its own list
# (shares.json in its data: names, levels, copies), and shares only what is
# in the launcher's; the launcher's follows it: a folder the node no longer
# shares (stopped from the workspace) leaves it within seconds (tick).

# folders: the launcher's list, one a line.
folders() { [ ! -f "$FOLDERS" ] || grep -v '^$' "$FOLDERS" || true; }

# write_binds: the proxy's copy of the list, replaced whole (it reads it
# again at each request).
write_binds() {
	mkdir -p "${BINDS%/*}"
	folders >"$BINDS.new"
	chmod 644 "$BINDS.new"
	mv "$BINDS.new" "$BINDS"
}

# present PATH: PATH is a folder of the host now (not a disk away or a folder
# deleted). A short-lived container of this image tells (the launcher does
# not see the host's folders).
present() {
	docker run --rm --network none --entrypoint true \
		--mount "type=bind,src=$1,dst=/place,readonly" "$SELF_IMAGE" >/dev/null 2>&1
}

# copyable_paths: the folders the node lets be copied (shares.json), one a
# line; fails when its list cannot be read.
copyable_paths() {
	[ -f "$DATA/node/shares.json" ] || return 0
	jq -r '(.folders // [])[] | select(.copyable == true) | .path | select(type == "string" and (explode | all(. >= 32 and . != 127)))' "$DATA/node/shares.json"
}

# copied: the folders of the list Syncthing is to have, one a line (as in
# the list, :ro kept): those the node lets be copied, and on the host now;
# fails when the node's list cannot be read.
copied() {
	cp=$(copyable_paths) || return 1
	[ -n "$cp" ] || return 0
	folders | while IFS= read -r l; do
		printf '%s\n' "$cp" | grep -Fxq -- "${l%:ro}" || continue
		if ! present "${l%:ro}"; then
			log "${l%:ro} is not a folder of this machine now: it is not copied until it is back"
			continue
		fi
		printf '%s\n' "$l"
	done
}

# folder_ok PATH: PATH may be shared, as written (it says why not): an
# absolute path, nothing hidden on the way, neither appdata, a system
# folder, an Unraid share's system or domains, nor Eriphe's own data or a
# folder holding it or the Docker socket; none of the characters the
# compose project, its .env or the places' lists read.
folder_ok() {
	case $1 in
	/?*) ;;
	*) echo "not an absolute path of this machine (/mnt/user/Documents)" && return 1 ;;
	esac
	case $1 in
	*/ | *//* | */./* | */../* | */. | */..) echo "not a folder's path as it is (no trailing /, no . or ..)" && return 1 ;;
	*[\'\"\\\$\`,:]*) echo "it has a quote, a backslash, a \$, a backtick, a comma or a colon: rename it, or share a folder inside it" && return 1 ;;
	*' ') echo "it ends with a space" && return 1 ;;
	*/.*) echo "hidden: Eriphe never shares a hidden folder" && return 1 ;;
	esac
	if printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'; then
		echo "it has a control character" && return 1
	fi
	if printf '%s/' "$1" | grep -qi '/appdata/'; then
		echo "appdata holds the containers' settings and tokens: never shared" && return 1
	fi
	if printf '%s' "$1" | grep -Eq '^/(bin|boot|dev|etc|lib|lib32|lib64|libx32|proc|root|run|sbin|sys|tmp|usr|var)(/|$)'; then
		echo "a folder of the system: never shared" && return 1
	fi
	if printf '%s' "$1" | grep -Eq '^/mnt/[^/]+/(system|domains)(/|$)'; then
		echo "Unraid's system and domains (Docker's and the VMs' disks): never shared" && return 1
	fi
	case $1/ in
	"$HOST_DATA"/*) echo "Eriphe's own data: never shared" && return 1 ;;
	esac
	case $HOST_DATA/ in
	"$1"/*) echo "it holds Eriphe's own data ($HOST_DATA): share a folder inside it" && return 1 ;;
	esac
	case $HOST_SOCK in
	"$1"/*) echo "it holds the Docker socket: never shared" && return 1 ;;
	esac
	return 0
}

# folder_check PATH: the node's own checks, on the host, before PATH is
# mounted into it (eriphe-node share check): a short-lived container of the
# node's image, without a network nor a capability but reading every
# folder, sees the host's / read-only; no symlink on the way, nothing
# sensitive or private in it or above it. It says why not.
folder_check() {
	rc=0
	out=$(docker run --rm --network none --read-only --cap-drop ALL --cap-add DAC_READ_SEARCH \
		--security-opt no-new-privileges --user 0:0 --mount type=bind,src=/,dst=/host,readonly \
		--entrypoint eriphe-node "$NODE_IMAGE" share check -host /host -data "$HOST_DATA" "$1" 2>&1) || rc=$?
	case $rc:$out in
	0:*) return 0 ;;
	*"no eriphe-node in"* | 2:*)
		# A node from before eriphe share: no share check, it wants its data.
		echo "this eriphe-node cannot check a folder yet: update Eriphe first (Settings › Devices › Update, or docker exec ${SELF_NAME:-eriphe} eriphe-launcher update)"
		return 1
		;;
	esac
	out=$(printf '%s\n' "$out" | tail -n 1)
	out=${out#"eriphe-node share: "}
	printf '%s\n' "${out#"$1: "}"
	return 1
}

# shared_paths: the folders in the node's list (shares.json), one a line;
# fails when it cannot be read. None before the first share.
shared_paths() {
	[ -f "$DATA/node/shares.json" ] || return 0
	jq -r '(.folders // [])[] | .path | select(type == "string" and (explode | all(. >= 32 and . != 127)))' "$DATA/node/shares.json"
}

# unshared [ONLY]: the folders of the launcher's list the node does not
# share (any longer), only those of ONLY (lines) if given; fails when the
# node's list cannot be read.
unshared() {
	shared=$(shared_paths) || return 1
	folders | while IFS= read -r l; do
		if printf '%s\n' "$shared" | grep -Fxq -- "${l%:ro}"; then continue; fi
		if [ -n "${1:-}" ] && ! printf '%s\n' "$1" | grep -Fxq -- "${l%:ro}"; then continue; fi
		printf '%s\n' "$l"
	done
}

# set_folders LINES: the launcher's list.
set_folders() {
	printf '%s\n' "$1" | grep -v '^$' >"$FOLDERS.new" || true
	mv "$FOLDERS.new" "$FOLDERS"
}

# drop_folders LINES: those lines off the launcher's list.
drop_folders() { set_folders "$(folders | grep -Fxv -- "$1" || true)"; }

# folders_migrate: an install from before, with places (ERIPHE_SHARES,
# shares=/mnt/user), gets the folders shared in them as its list, each
# checked again (a :ro place's read-only); the places themselves go. Once.
folders_migrate() {
	[ ! -f "$FOLDERS" ] || return 0
	places=${ERIPHE_SHARES:-$(sed -n 's/^shares=//p' "$CONF/install.conf" 2>/dev/null | head -n 1)}
	list=''
	if [ -n "$places" ]; then
		shared=$(shared_paths) || {
			log "the node's list of shared folders cannot be read: its folders are kept for the next start"
			return 0
		}
		while IFS= read -r p; do
			[ -n "$p" ] || continue
			ro='' found=''
			set -f
			old_ifs=$IFS IFS=,
			for s in $places; do
				pl=${s#*=} r=''
				case $pl in *:ro) pl=${pl%:ro} r=:ro ;; esac
				case $p/ in "${pl%/}"/*) found=1 ro=$r && break ;; esac
			done
			IFS=$old_ifs
			set +f
			[ -n "$found" ] || continue
			if why=$(folder_ok "$p"); then
				list="$list$p$ro$NL"
			else
				log "$p is no longer given to Eriphe: $why"
			fi
		done <<EOF
$shared
EOF
	fi
	mkdir -p "$CONF"
	set_folders "$list"
	[ -z "$places" ] || log "the places ($places) are gone: each of the $(folders | grep -c . || true) folders shared is now given alone"
}

# lan_address: the host's address on the LAN, from a short-lived container
# on the host's network (this one has none of its own to tell).
lan_address() {
	if [ -n "${ERIPHE_ADDRESS:-}" ]; then
		printf '%s' "$ERIPHE_ADDRESS"
		return
	fi
	docker run --rm --network host --entrypoint ip "$SELF_IMAGE" route get 1.1.1.1 2>/dev/null |
		sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1
}

# wake_card: install.sh's, run in a short-lived container on the host's
# network: this one's card is Docker's, not the machine's.
wake_card() {
	docker run --rm --network host --entrypoint sh -e ERIPHE_INSTALL_LIB=1 -e CORE_URL="${CORE_URL:-}" "$SELF_IMAGE" \
		-c '. /usr/local/lib/eriphe/install.sh && wake_card' 2>/dev/null || true
}

uninstalled() { [ -f "$CONF/uninstalled" ]; }

idle() {
	while :; do
		sleep 3600 &
		wait $! || true
	done
}

# run: the container's command. The stack as install.sh would make it, the
# images pulled on the first install and afterwards only when missing (an
# update is the updater's), then the updater's loop.
run() {
	trap 'exit 0' TERM INT
	discover
	log "${ERIPHE_LAUNCHER_VERSION:-dev}, data in $HOST_DATA"
	if uninstalled; then
		log "Eriphe was uninstalled from here (eriphe-launcher uninstall): remove this container, or delete $HOST_DATA/launcher/uninstalled to install it again"
		idle
	fi
	mkdir -p "$CONF"
	chmod 700 "$CONF"
	folders_migrate
	# What the node no longer shares leaves the list.
	if gone=$(unshared) && [ -n "$gone" ]; then
		drop_folders "$gone"
	fi
	write_binds
	# A first install takes the current images, even if older ones with the
	# same tag are already on this machine; a restart never updates.
	PULL=missing UPDATE_BY=loop FIRST=''
	[ -f "$CONF/install.conf" ] || PULL=always FIRST=1
	settings
	say ""
	if [ -n "$FIRST" ] && [ "$MODE" = node ]; then
		say "Connecting this machine to $ASSISTANT"
	elif [ -n "$FIRST" ]; then
		say "Installing Eriphe on this machine"
	else
		say "Starting Eriphe on this machine"
	fi
	say ""
	on_steps host_docker
	INFO=$OUT
	settle
	stack_up
	summary "$OUT"
	loop
}

# stack_up: the compose project written and up, as install.sh's host_up.
stack_up() {
	version=$(info docker_version)
	isolated=1
	if [ "${version%%.*}" -lt 28 ] 2>/dev/null; then
		notice "Docker on this machine is older than version 28: update it, so that tasks cannot reach this machine's own services."
		isolated=0
	fi
	on_steps host_up "$(info docker_gid)" "$isolated"
	printf '%s\n' "$COPIED" >"$COPIED_NOW"
}

# sync_folders: the proxy's list written again, and Syncthing alone made
# again if the folders it may copy changed (nothing else restarts).
sync_folders() {
	write_binds
	now=$(copied) || return 0
	[ "$now" != "$(cat "$COPIED_NOW" 2>/dev/null || true)" ] || return 0
	COPIED=$now
	isolated=1
	[ "$(info docker_version | cut -d . -f 1)" -ge 28 ] 2>/dev/null || isolated=0
	compose_yaml "$(info docker_gid)" "$isolated" >"$CONF/compose.yaml.new"
	mv "$CONF/compose.yaml.new" "$CONF/compose.yaml"
	say "Copies to your other machines pause a few seconds (Syncthing starts again with the folders it may copy)..."
	if dc up -d --no-deps --pull never syncthing >/dev/null 2>&1; then
		printf '%s\n' "$now" >"$COPIED_NOW"
	else
		log "could not start Syncthing again on the folders it may copy: tried again at the next change"
	fi
}

# summary OUT: as install.sh's outcome, for this container's log.
summary() {
	addr=$(lan_address)
	[ -z "${BIND:-}" ] || addr=$BIND
	addr=${addr:-<this-machine>}
	say ""
	if [ "$MODE" = core ]; then
		code=$(printf '%s\n' "$1" | sed -n 's/^setup_code=//p')
		REMOTE_URL=$(printf '%s\n' "$1" | sed -n 's/^remote=//p')
		if [ -n "$code" ]; then
			para "Done: Eriphe runs on this machine. To finish, open this address in your browser and give the setup code:"
			say ""
			say "  https://$addr:$WEB_PORT/setup"
			say "  Setup code: $code"
			notice "then the browser asks you to name your assistant and connect its AI account."
		elif [ -n "$REMOTE_URL" ]; then
			para "Eriphe runs on this machine: open $REMOTE_URL in your browser, from a device on your Tailscale network, and sign in (forgotten password: $(password_reset))."
		else
			para "Eriphe runs on this machine: open https://$addr:$WEB_PORT in your browser and sign in (forgotten password: $(password_reset))."
		fi
		notice "to connect your other computers, open Réglages › Appareils › Connecter un appareil (Settings › Devices › Connect a device) in your browser."
		exposed_notice "$addr" "set ERIPHE_BIND=127.0.0.1"
	elif [ -n "$FIRST" ]; then
		para "Done: this machine is connected to $ASSISTANT. Go back to your browser: it now appears in Appareils (Devices)."
	else
		para "This machine is connected to $ASSISTANT."
	fi
	if [ "$PIN" = edge ]; then
		notice "it follows main, the version in development (ERIPHE_VERSION=latest follows the releases)."
	elif [ -n "$PIN" ]; then
		notice "it stays on version $PIN (ERIPHE_VERSION=latest follows the releases)."
	fi
	if [ -n "$(folders)" ]; then
		note "Folders shared with Eriphe here: $SHARE_COMMAND list; to share another: $SHARE_COMMAND add <folder> (--drop to let it drop its results there)"
	else
		notice "Eriphe opens no folder of this machine yet: share one with $SHARE_COMMAND add <folder> (--drop to let it drop its results there)."
	fi
	good_to_know
	say ""
	logs="docker logs eriphe-node"
	[ "$MODE" != core ] || logs="docker logs eriphe-core, $logs"
	say "Logs: $logs (updates: docker logs ${SELF_NAME:-eriphe})"
	say ""
}

# loop: the updater, as install.sh's systemd units run it: when a request
# is dropped.
loop() {
	log "waiting for update requests"
	while :; do
		tick
		sleep "${ERIPHE_LAUNCHER_POLL:-5}" &
		wait $! || true
	done
}

# tick: the requests waiting, if any, then eriphe-launcher itself, last;
# and the node's list followed when it changed (a folder stopped from the
# workspace, its copies turned off), unless a share command is under way.
tick() {
	sum=$(cksum <"$DATA/node/shares.json" 2>/dev/null || true)
	if [ "$sum" != "${SHARES_SUM:-}" ]; then
		exec 7>"$CONF/apply.lock"
		if ! command -v flock >/dev/null 2>&1 || flock -n 7; then
			SHARES_SUM=$sum
			if gone=$(unshared) && [ -n "$gone" ]; then
				drop_folders "$gone"
				log "no longer shared: $(printf '%s' "$gone" | tr '\n' ' ')"
			fi
			sync_folders >&2
		fi
		exec 7>&-
	fi
	for t in core node; do
		if [ -f "$DATA/$t/update-requested" ]; then
			apply
			[ -z "$SELF_TO" ] || self_update "$SELF_TO"
			return
		fi
	done
}

status_of() { sed -n "s/^$2=//p" "$DATA/$1/update-status" 2>/dev/null | head -n 1; }

# apply [rollback]: install.sh's updater on the requests waiting (or a
# rollback), one at a time. SELF_TO is then the build eriphe-launcher is to
# update itself to, once the machine's update went well: the version it
# runs now (self_update, after).
apply() {
	SELF_TO=
	exec 8>"$CONF/apply.lock"
	! command -v flock >/dev/null 2>&1 || flock 8
	before="core=$(status_of core id) node=$(status_of node id)"
	sh "$CONF/update.sh" "$@" || log "the updater failed"
	for t in core node; do
		id=$(status_of "$t" id)
		case "$before " in
		*"$t=$id "*) continue ;; # not one of this run
		esac
		case $(status_of "$t" action):$(status_of "$t" outcome) in
		update:ok | update:current | update:pinned) SELF_TO=$(status_of "$t" to) ;;
		esac
	done
	exec 8>&-
}

# self_update VERSION: this image of the build VERSION, then this container
# replaced by one of it (a container cannot recreate itself: a short-lived
# one of the new image does, eriphe-launcher swap). Never newer than what it
# runs, and only an official image (a local build stays as it is).
self_update() {
	tag=$(version_tag "$1") || return 0
	if [ "$(ref_repo "$SELF_REF")" != "$LAUNCHER_REPO" ]; then
		log "$SELF_REF is not $LAUNCHER_REPO: not updated"
		return 0
	fi
	src=$LAUNCHER_REPO:$tag
	if ! out=$(docker pull -q "$src" 2>&1); then
		log "could not pull $src: $(printf '%s' "$out" | tail -n 1)"
		return 0
	fi
	new=$(docker image inspect -f '{{.Id}}' "$src")
	if [ "$src" != "$SELF_REF" ]; then
		docker tag "$src" "$SELF_REF"
		docker image rm "$src" >/dev/null 2>&1 || true
	fi
	[ "$new" != "$SELF_IMAGE" ] || return 0
	log "updating itself to $tag"
	docker rm -f "$SWAP" >/dev/null 2>&1 || true
	# As hardened as the launcher: root for the socket, no capability.
	docker run -d --rm --name "$SWAP" --network none --label eriphe.launcher=swap \
		--cap-drop ALL --read-only --tmpfs /tmp --security-opt no-new-privileges \
		-v "$HOST_SOCK:$SOCK" "$new" swap "$SELF" >/dev/null ||
		log "could not start $SWAP"
}

api() {
	curl -sS --fail-with-body --unix-socket "$SOCK" -H 'Content-Type: application/json' "$@"
}

# create_body INSPECT IMAGE_CONFIG: what POST /containers/create takes to
# make the container of INSPECT again from the image now under its
# reference: its own settings, not what came from its old image (watchtower
# does the same).
create_body() {
	printf '%s' "$1" | jq --argjson img "$2" '
		.Id[0:12] as $short |
		.Config + {
			Env: [(.Config.Env // [])[] | select(. as $e | ($img.Env // []) | index([$e]) | not)],
			Labels: ((.Config.Labels // {}) | with_entries(select(.value != ($img.Labels // {})[.key]))),
			HostConfig: .HostConfig,
			NetworkingConfig: {EndpointsConfig: ((.NetworkSettings.Networks // {}) | map_values(
				{IPAMConfig, Aliases: ((.Aliases // []) | map(select(startswith($short) | not)))}))}
		}
		| if .Hostname == $short then del(.Hostname) else . end
		| if .Cmd == $img.Cmd then del(.Cmd) else . end
		| if .Entrypoint == $img.Entrypoint then del(.Entrypoint) else . end
		| if .WorkingDir == $img.WorkingDir then del(.WorkingDir) else . end'
}

# swap OLD: OLD stopped, the same container made again from the image now
# under its reference, and OLD removed once the new one runs; OLD back if
# not.
swap() {
	old=$1
	j=$(api "http://docker/containers/$old/json") || die "no container $old"
	name=$(printf '%s' "$j" | jq -r '.Name | ltrimstr("/")')
	ref=$(printf '%s' "$j" | jq -r .Config.Image)
	oldimg=$(printf '%s' "$j" | jq -r .Image)
	img=$(api "http://docker/images/$oldimg/json" | jq -c '.Config // {}') || img='{}'
	body=$(create_body "$j" "$img" | jq --arg ref "$ref" '.Image = $ref')
	log "replacing $name"
	docker stop -t 30 "$old" >/dev/null
	docker rename "$old" "$name-previous"
	new=
	if out=$(api -X POST -d "$body" "http://docker/containers/create?name=$name" 2>&1) &&
		new=$(printf '%s' "$out" | jq -r .Id) && docker start "$new" >/dev/null; then
		sleep "${ERIPHE_SWAP_CHECK:-15}"
		if [ "$(docker inspect -f '{{.State.Running}} {{.State.Restarting}}' "$new" 2>/dev/null)" = "true false" ]; then
			docker rm "$old" >/dev/null
			docker image rm "$oldimg" >/dev/null 2>&1 || true
			log "$name replaced"
			return 0
		fi
		out="the new $name does not stay up"
	fi
	log "could not replace $name ($(printf '%s' "$out" | tail -n 1)): back to the previous one"
	[ -z "$new" ] || docker rm -f "$new" >/dev/null 2>&1 || true
	docker rename "$name-previous" "$name"
	docker start "$old" >/dev/null
	return 1
}

# request ACTION TARGET CORE: a request of the machine itself, as
# eriphe-core's (install/README.md, The machines update themselves).
request() {
	printf 'id=local-%s\naction=%s\ncore=%s\nauto=0\n' "$(date +%s)" "$1" "$3" >"$DATA/$2/update-requested"
}

# local_update ACTION: an update (eriphe-core's machine first, then its
# node, on eriphe-core's build) or a rollback, now.
local_update() {
	[ -f "$CONF/update.sh" ] || die "Eriphe is not installed here yet: the container's first start does it"
	uninstalled && die "Eriphe was uninstalled from here"
	discover
	MODE=$(sed -n 's/^mode=//p' "$CONF/install.conf")
	main=node to=
	[ "$MODE" != core ] || main=core
	if [ "$1" = rollback ]; then
		apply rollback
	else
		request update "$main" ""
		apply
		to=$SELF_TO
		if [ "$main" = core ] && [ -n "$to" ]; then
			request update node "$to"
			apply
			to=${SELF_TO:-$to}
		fi
	fi
	for t in core node; do
		[ -f "$DATA/$t/update-status" ] || continue
		say "eriphe-$t: $(show_status <"$DATA/$t/update-status")"
	done
	# Last: this container is replaced, which ends this command.
	[ "$1" = rollback ] || [ -z "$to" ] || self_update "$to"
}

# ---- eriphe share

share_usage() {
	cat <<'EOF'
eriphe share: the folders of this machine shared with Eriphe. Its tasks get
each folder they are given alone, at its path, and nothing else of this
machine. Sharing a folder, or stopping, restarts nothing: the next task has
it, or no longer has it (a task at work keeps it until it ends); only the
copies to your other machines pause a few seconds when the folders that may
be copied change.

  eriphe share add [--name NAME] [--read|--drop|--manage] [--copyable] FOLDER...
      share each folder (its path on this machine: /mnt/user/Documents),
      read-only by default (--read); --drop also lets tasks drop their
      results in its results subfolder; --manage lets them create, change
      and delete anything in it, a snapshot taken before each such task;
      --copyable allows copies on your other machines; --name: the name
      Eriphe knows it by (one folder only). Again on a folder shared: its
      level and copies anew.
  eriphe share remove NAME|FOLDER...
      stop sharing: no new task gets it
  eriphe share list [--json]
  eriphe share snapshots NAME|FOLDER
  eriphe share restore NAME|FOLDER SNAPSHOT|latest

Never shared: hidden folders, appdata, a folder holding keys, passwords or
settings, a symlink, a system folder, Eriphe's own data.
EOF
}

# share CMD ARGS...: eriphe share.
share() {
	cmd=${1:-}
	[ $# -eq 0 ] || shift
	case $cmd in
	add) share_add "$@" ;;
	remove | rm) share_remove "$@" ;;
	list | snapshots | restore)
		share_installed
		exec docker exec eriphe-node eriphe-node share "$cmd" "$@"
		;;
	'' | -h | --help | help) share_usage ;;
	*) die "unknown command eriphe share $cmd (eriphe share --help)" ;;
	esac
}

share_installed() {
	[ -f "$CONF/install.conf" ] || die "Eriphe is not installed here yet: the container's first start does it"
	! uninstalled || die "Eriphe was uninstalled from here"
}

# share_ready: what a change of the list needs: no update under way (its
# lock), the settings, the host's answer.
share_ready() {
	share_installed
	discover
	exec 8>"$CONF/apply.lock"
	! command -v flock >/dev/null 2>&1 || flock 8
	folders_migrate
	PULL=missing UPDATE_BY=loop
	settings
	on_steps host_docker
	INFO=$OUT
	settle
}

# share_add ARGS...: each folder checked here (folder_ok), then by the
# node's own checks on the host (folder_check), put in the list (the
# proxy's too), then shared by the node, with the level and copies asked; a
# folder the node does not share leaves the list again.
share_add() {
	level='' copy='' fname='' named='' asked=''
	while [ $# -gt 0 ]; do
		case $1 in
		-read | --read | -drop | --drop | -manage | --manage)
			l=--${1##*-}
			[ -z "$level" ] || [ "$level" = "$l" ] || die "--read, --drop and --manage: choose one"
			level=$l
			;;
		-copyable | --copyable) copy=1 ;;
		-name | --name)
			[ $# -ge 2 ] || die "--name takes the name Eriphe knows the folder by"
			fname=$2 named=1
			shift
			;;
		-name=* | --name=*) fname=${1#*=} named=1 ;;
		-?*) die "unknown option $1 (eriphe share --help)" ;;
		*)
			case $1 in *"$NL"*) die "a folder's path is one line" ;; esac
			asked="$asked$1$NL"
			;;
		esac
		shift
	done
	if [ -z "$asked" ]; then
		share_usage >&2
		exit 2
	fi
	[ -z "$named" ] || [ "$(printf '%s' "$asked" | grep -c .)" = 1 ] || die "--name is for one folder only"
	share_ready
	cur=$(folders) want=$(folders) given='' failed=''
	set -f
	old_ifs=$IFS IFS=$NL
	for p in $asked; do
		IFS=$old_ifs
		if ! why=$(folder_ok "$p"); then
			say "Not shared: $p: $why"
			failed=1
			continue
		fi
		if printf '%s\n' "$want" | grep -Fxq -- "$p:ro"; then
			# Read-only, from a :ro place: written to only if asked now.
			if [ "$level" = --drop ] || [ "$level" = --manage ]; then
				want=$(printf '%s\n' "$want" | grep -Fxv -- "$p:ro" || true)$NL$p
			fi
		elif ! printf '%s\n' "$want" | grep -Fxq -- "$p"; then
			if ! why=$(folder_check "$p"); then
				say "Not shared: $p: $why"
				failed=1
				continue
			fi
			want=$want$NL$p
		fi
		given=$given$p$NL
	done
	IFS=$old_ifs
	set +f
	[ -n "$given" ] || exit 1
	want=$(printf '%s\n' "$want" | grep -v '^$' || true)
	[ "$want" = "$cur" ] || set_folders "$want"
	write_binds
	# The node's own share add, the proxy allowing the folders: its checks
	# (in helpers given the folder), the level and the copies, its list.
	set --
	[ -z "$level" ] || set -- "$level"
	[ -z "$copy" ] || set -- "$@" --copyable
	[ -z "$named" ] || set -- "$@" --name "$fname"
	set -f
	IFS=$NL
	for p in $given; do set -- "$@" "$p"; done
	IFS=$old_ifs
	set +f
	rc=0
	docker exec -e ERIPHE_SHARE_COMMAND= eriphe-node eriphe-node share add "$@" || rc=$?
	if gone=$(unshared "$given") && [ -n "$gone" ]; then
		drop_folders "$gone"
	fi
	sync_folders
	[ "$rc" != 0 ] || [ -z "$failed" ] || rc=1
	exit "$rc"
}

# share_remove NAME|FOLDER...: the node stops sharing them (no new task
# gets them; a task at work keeps them until it ends), then they leave the
# list, the proxy's and Syncthing's.
share_remove() {
	if [ $# -eq 0 ]; then
		share_usage >&2
		exit 2
	fi
	share_ready
	rc=0
	docker exec eriphe-node eriphe-node share remove "$@" || rc=$?
	if gone=$(unshared) && [ -n "$gone" ]; then
		drop_folders "$gone"
	fi
	sync_folders
	exit "$rc"
}

# uninstall [--data]: install.sh --uninstall's work on what this container
# made; its data stays unless --data. The container is then stopped, kept
# from starting again, for you to remove.
uninstall() {
	purge=
	case ${1:-} in
	--data) purge=1 ;;
	'') ;;
	*) die "uninstall takes --data, to remove the data too" ;;
	esac
	discover
	say "Removing Eriphe from this machine"
	say ""
	if [ -f "$CONF/compose.yaml" ]; then
		note "Removing the containers..."
		dc down --remove-orphans >/dev/null 2>&1 || true
	fi
	ids=$(docker ps -aq --filter label=eriphe.task; docker ps -aq --filter label=eriphe.service)
	# shellcheck disable=SC2086 # one argument per id
	[ -z "$ids" ] || docker rm -f $ids >/dev/null
	docker network rm eriphe-tasks eriphe-system eriphe-docker >/dev/null 2>&1 || true
	docker volume rm eriphe-cache >/dev/null 2>&1 || true
	for repo in $LEGACY_PROXY $REGISTRY/eriphe-node $REGISTRY/eriphe-base $REGISTRY/eriphe-worker $REGISTRY/eriphe-core; do
		refs=$(docker images --format '{{.Repository}}:{{.Tag}}' "$repo" | grep -v ':<none>$' || true)
		# shellcheck disable=SC2086 # one argument per image
		[ -z "$refs" ] || docker image rm $refs >/dev/null 2>&1 || true
	done
	if [ -n "$purge" ]; then
		note "Removing Eriphe's data ($HOST_DATA)..."
		find "$DATA" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
	fi
	mkdir -p "$CONF"
	echo "eriphe-launcher uninstall, $(date)" >"$CONF/uninstalled"
	step Removed
	say ""
	if [ -n "$purge" ]; then
		say "Eriphe and its data were removed from this machine."
	else
		say "Eriphe was removed from this machine."
		notice "its data stays in $HOST_DATA: delete that folder to remove it too."
	fi
	para "Last step: remove this container, docker rm -f $SELF_NAME (on Unraid: Docker, $SELF_NAME, Remove)."
	notice "if it was connected to Eriphe on another computer, forget it there too: Réglages › Appareils (Settings › Devices), in your browser."
	good_to_know
	docker update --restart no "$SELF" >/dev/null 2>&1 || true
	docker stop -t 2 "$SELF" >/dev/null 2>&1 || true
}

# The tests (launcher_test.sh) source it for its functions.
[ -z "${ERIPHE_LAUNCHER_SOURCED:-}" ] || return 0

# As eriphe (docker exec eriphe eriphe share ...): its share command only.
if [ "${0##*/}" = eriphe ]; then
	case ${1:-} in
	share) ;;
	*) die "eriphe here is for the folders shared: eriphe share add|remove|list|snapshots|restore (eriphe share --help)" ;;
	esac
fi

case ${1:-run} in
run) run ;;
share)
	shift
	share "$@"
	;;
update) local_update update ;;
rollback) local_update rollback ;;
uninstall)
	shift
	uninstall "$@"
	;;
swap)
	[ $# -eq 2 ] || die "swap takes the container to replace"
	swap "$2"
	;;
-h | --help) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//' ;;
*) die "unknown command $1 (run, update, rollback, uninstall, share)" ;;
esac
